@startuml nad-containers-fr
!include <C4/C4_Container>
LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()
skinparam dpi 150

title NAD - Vue conteneurs (déploiement de référence)

Person(admin, "Administrateur réseau", "Consulte le tableau de bord et les alertes")

System_Boundary(site, "Réseau de l'entreprise") {
  System_Ext(users, "Utilisateurs", "Postes de travail et téléphones")
  System_Ext(lan, "Switchs et routeurs", "Équipements en aval, tous connectés au routeur principal")
  System_Ext(gateway, "MikroTik RB1100AHx4", "Routeur principal (RouterOS), NAT, exporte Traffic-Flow, SNMP, syslog")
  System_Ext(slrouter, "Routeur Starlink", "Second NAT, premier saut vers la liaison montante")
  System_Ext(uplink, "Starlink", "Liaison montante satellite")
}

System_Boundary(nad, "Hôte NAD (Linux, systemd), sur le réseau local ou distant via WireGuard") {
  Container(telegraf, "Telegraf", "SNMP + ICMP", "Interroge les compteurs du routeur, mesure latence et perte")
  Container(goflow, "goflow2", "NetFlow v9/IPFIX", "Décode les flux en JSON")
  Container(rsyslog, "rsyslog", "Récepteur syslog", "Stocke les journaux du routeur")
  Container(ingest, "Ingesteur", "Python", "Lit les fichiers bruts, construit des fenêtres de 1 minute")
  ContainerDb(store, "Stockage", "SQLite + Parquet", "Fenêtres, scores, événements d'anomalie")
  Container(detector, "Détecteur", "Python, scikit-learn", "Caractéristiques, Isolation Forest, référence saisonnière")
  Container(dashboard, "Tableau de bord", "Streamlit", "Statistiques et anomalies mises en évidence")
  Container(alerts, "Alerte", "Webhook, optionnel", "Notifie les nouveaux événements d'anomalie")
}

Rel(users, lan, "Trafic")
Rel(lan, gateway, "Trafic")
Rel(gateway, slrouter, "Trafic")
Rel(slrouter, uplink, "Trafic")

Rel(telegraf, gateway, "Interrogation SNMP", "Réseau local ou WireGuard")
Rel(telegraf, slrouter, "Sondes ICMP (premier saut)")
Rel(telegraf, uplink, "Sondes ICMP (cibles Internet)")
Rel(gateway, goflow, "Traffic-Flow", "UDP 2055, réseau local ou WireGuard")
Rel(gateway, rsyslog, "Syslog", "UDP 514, réseau local ou WireGuard")

Rel(telegraf, ingest, "Lignes JSON")
Rel(goflow, ingest, "Lignes JSON")
Rel(rsyslog, ingest, "Fichiers de journaux")
Rel(ingest, store, "Écrit les fenêtres")
Rel(detector, store, "Lit les fenêtres, écrit les scores")
Rel(dashboard, store, "Lit")
Rel(detector, alerts, "Nouveaux événements d'anomalie")

Rel(admin, dashboard, "Consulte")
Rel(alerts, admin, "Notifie")
@enduml
